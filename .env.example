# Dokumentarkiv runtime configuration
# Local development uses ../data from the backend workspace by default.
# In Docker, set DATA_DIR=/data.
PORT=3001
DATA_DIR=../data

# OCR is internal search data only; it is never displayed in the GUI.
OCR_ENABLED=true
OCR_LANGUAGES=swe+eng
OCR_MAX_PDF_PAGES=30
OCR_TIMEOUT_MS=120000
OCR_MAX_CHARS=500000
OCR_MIN_PDF_TEXT_CHARS=80
